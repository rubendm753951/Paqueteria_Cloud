@page
@model Paqueteria.Web.Pages.Agencias.IndexModel

@{
    ViewData["Title"] = "Agencias";
}

<section class="agency-list-page">
    <header class="agency-list-heading">
        <div>
            <p class="agency-kicker">SIEXPRO / CATÁLOGOS</p>
            <h1>Agencias</h1>
            <p>Consulta las agencias habilitadas para tu cuenta.</p>
        </div>
        <div class="agency-heading-actions">
            @if (Model.CanManageProductAssignments)
            {
                <a asp-page="/Productos/Tarifario" class="agency-secondary-link">Asignar productos <span aria-hidden="true">&rarr;</span></a>
            }
            @if (Model.CanCreateAgency || Model.EditableAgencyIds.Count > 0)
            {
                <a asp-page="./Create" class="agency-primary-link">Administrar agencias <span aria-hidden="true">&rarr;</span></a>
            }
        </div>
    </header>

    <div class="agency-list-meta">
        <span>@Model.CAgencia.Count @(Model.CAgencia.Count == 1 ? "agencia disponible" : "agencias disponibles")</span>
    </div>

    <div class="agency-table-wrap">
        <table class="agency-table">
            <thead>
                <tr><th>Agencia</th><th>Ubicación</th><th>Corporativo</th><th>Moneda</th><th>País</th><th>Contacto</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var item in Model.CAgencia)
            {
                <tr>
                    <td><strong>@item.Nombre</strong><small>ID @item.IdAgencia</small></td>
                    <td>@item.Ciudad, @item.EstadoProvincia<small>@item.CodigoPostal · @item.Colonia</small></td>
                    <td>@item.IdCorporativoNavigation.Nombre<small>ID @item.IdCorporativo</small></td>
                    <td>@item.IdMonedaNavigation.Nombre<small>@item.IdMonedaNavigation.Abreviatura</small></td>
                    <td>@item.IdPaisNavigation.Nombre<small>ID @item.IdPais</small></td>
                    <td>@item.Telefono<small>@item.Email</small></td>
                    <td class="agency-row-actions">
                        <a asp-page="./Details" asp-route-id="@item.IdAgencia">Ver</a>
                        @if (Model.EditableAgencyIds.Contains(item.IdAgencia))
                        {
                            <a asp-page="./Create" asp-route-agencyId="@item.IdAgencia">Editar</a>
                        }
                        @if (Model.DeletableAgencyIds.Contains(item.IdAgencia))
                        {
                            <a asp-page="./Delete" asp-route-id="@item.IdAgencia" class="agency-delete-link">Dar de baja</a>
                        }
                    </td>
                </tr>
            }
            @if (Model.CAgencia.Count == 0)
            {
                <tr><td colspan="7" class="agency-empty">No hay agencias asignadas a tu cuenta.</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>
