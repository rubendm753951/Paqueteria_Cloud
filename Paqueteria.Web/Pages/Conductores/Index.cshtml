@page
@model Paqueteria.Web.Pages.Conductores.IndexModel
@{ ViewData["Title"] = "Conductores"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><a asp-page="/Envios/Index" class="text-decoration-none">&larr; Envíos</a><h1 class="mt-3 mb-1">Conductores</h1><p class="text-muted mb-0">Administra los repartidores disponibles por agencia.</p></div></div>
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="alert alert-success">@Model.StatusMessage</div> }
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<div class="row g-4">
    <div class="col-lg-4"><div class="card shadow-sm"><div class="card-header fw-semibold">Nuevo conductor</div><div class="card-body"><form method="post" asp-page-handler="Create"><div class="mb-3"><label asp-for="Input.AgencyId" class="form-label">Agencia</label><select asp-for="Input.AgencyId" class="form-select"><option value="">Selecciona</option>@foreach (var agency in Model.Agencies) { <option value="@agency.Id">@agency.Name</option> }</select></div><div class="mb-3"><label asp-for="Input.EmployeeCode" class="form-label">Código empleado</label><input asp-for="Input.EmployeeCode" class="form-control" /></div><div class="row g-2"><div class="col"><label asp-for="Input.FirstName" class="form-label">Nombre</label><input asp-for="Input.FirstName" class="form-control" /></div><div class="col"><label asp-for="Input.LastName" class="form-label">Apellidos</label><input asp-for="Input.LastName" class="form-control" /></div></div><div class="mb-3 mt-3"><label asp-for="Input.Phone" class="form-label">Teléfono</label><input asp-for="Input.Phone" class="form-control" /></div><div class="mb-3"><label asp-for="Input.LicenseNumber" class="form-label">Licencia</label><input asp-for="Input.LicenseNumber" class="form-control" /></div><button class="btn btn-primary w-100" type="submit">Crear conductor</button></form></div></div></div>
    <div class="col-lg-8"><div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Conductor</th><th>Agencia</th><th>Código</th><th>Teléfono</th><th>Estado</th><th></th></tr></thead><tbody>@if (Model.Drivers.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-5">No hay conductores registrados.</td></tr> } @foreach (var driver in Model.Drivers) { <tr><td class="fw-semibold">@driver.Name</td><td>@driver.AgencyName</td><td>@driver.EmployeeCode</td><td>@driver.Phone</td><td><span class="badge @(driver.Status == "activo" ? "text-bg-success" : "text-bg-secondary")">@driver.Status</span></td><td class="text-end"><form method="post" asp-page-handler="Toggle" asp-route-id="@driver.Id"><button class="btn btn-sm btn-outline-secondary" type="submit">@(driver.Status == "activo" ? "Desactivar" : "Activar")</button></form></td></tr> } </tbody></table></div></div></div>
</div>
