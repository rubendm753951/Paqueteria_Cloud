@page
@model Paqueteria.Web.Pages.Productos.IndexModel
@{
    ViewData["Title"] = "Catálogo de productos";
}

<section class="products-page">
    <header class="products-heading">
        <div>
            <p class="products-kicker">SIEXPRO / CONFIGURACIÓN</p>
            <h1>Catálogo de productos</h1>
            <p>Administra los servicios disponibles para cotizar y enviar.</p>
        </div>
        @if (Model.CanEdit)
        {
            <a asp-page="./Tarifario" class="products-action-link">Asignar tarifas <span aria-hidden="true">&rarr;</span></a>
        }
    </header>

    <form method="get" class="products-search">
        <label for="product-search">Buscar producto</label>
        <input id="product-search" name="Search" value="@Model.Search" placeholder="SKU o nombre" />
        <button type="submit">Buscar</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="product-status-message" role="status">@Model.StatusMessage</div>
    }

    @if (Model.CanCreate)
    {
        <details class="product-create">
            <summary>Agregar producto maestro</summary>
            <form method="post" asp-page-handler="Create" class="product-create-fields">
                <div asp-validation-summary="ModelOnly" class="product-validation"></div>
                <label>SKU<input asp-for="NewProduct.SkuCodigo" maxlength="50" /></label>
                <label>Nombre<input asp-for="NewProduct.Nombre" maxlength="160" /></label>
                <label>Descripción<textarea asp-for="NewProduct.Descripcion" rows="2" maxlength="2000"></textarea></label>
                <button type="submit">Guardar producto</button>
            </form>
        </details>
    }

    <div class="products-table-wrap">
        <table class="products-table">
            <thead><tr><th>SKU</th><th>Producto</th><th>Descripción</th><th>Estado</th><th>Creado</th><th></th></tr></thead>
            <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td class="products-sku">@product.SkuCodigo</td>
                    <td>@product.Nombre</td>
                    <td>@product.Descripcion</td>
                    <td><span class="product-state @(product.Estado == "activo" ? "is-active" : "is-inactive")">@product.Estado</span></td>
                    <td>@product.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (Model.CanEdit)
                        {
                            <details class="product-edit">
                                <summary>Editar</summary>
                                <form method="post" asp-page-handler="Update" asp-route-id="@product.Id">
                                    <input type="hidden" name="Search" value="@Model.Search" />
                                    <label>SKU<input name="skuCodigo" value="@product.SkuCodigo" maxlength="50" required /></label>
                                    <label>Nombre<input name="nombre" value="@product.Nombre" maxlength="160" required /></label>
                                    <label>Descripción<textarea name="descripcion" maxlength="2000" rows="2">@product.Descripcion</textarea></label>
                                    <button type="submit">Guardar cambios</button>
                                </form>
                            </details>
                        }
                        @if (Model.CanDeactivate && product.Estado == "activo")
                        {
                            <form method="post" asp-page-handler="Deactivate" asp-route-id="@product.Id">
                                <button type="submit" class="product-deactivate">Dar de baja</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Products.Count == 0)
            {
                <tr><td colspan="6" class="products-empty">No hay productos que coincidan con la búsqueda.</td></tr>
            }
            </tbody>
        </table>
    </div>

    <nav class="products-pagination" aria-label="Paginación">
        <span>Página @Model.CurrentPage de @Model.TotalPages</span>
        <div>
            @if (Model.CurrentPage > 1)
            {
                <a asp-page="./Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search">Anterior</a>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-page="./Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search">Siguiente</a>
            }
        </div>
    </nav>
</section>